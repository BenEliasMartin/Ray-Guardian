# Run node scripts/bootstrap.mjs from repository root to generate local security values.
VERDA_INFERENCE_KEY=
VERDA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
VERDA_MODEL=nemotron-3.5-super-vl
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# false requires ElevenLabs enterprise zero-retention entitlement. Check your account.
ELEVENLABS_ENABLE_LOGGING=true
RAY_GUARDIAN_CLIENT_TOKEN=
DATA_ENCRYPTION_KEY=
MEDIA_SIGNING_SECRET=
HOST=127.0.0.1
PORT=8787
# playback = genuine ElevenLabs audio in companion. twilio = real call to allowed test phone.
DEMO_CALL_TRANSPORT=playback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEMO_CALL_FROM=
DEMO_CALL_TO=
DEMO_CALL_ALLOWLIST=
# Twilio needs a public HTTPS URL whose exact value is also used in callback signature checks.
PUBLIC_BASE_URL=
# Optional overrides: paths are resolved relative to process working directory.
# DATA_PATH=/absolute/path/guardian.sqlite
# REPLAY_DIRECTORY=/absolute/path/ReplayMedia

AI_BASE_URL=http://10.0.2.2:8787
# Legacy fixed-phrase clients may override ELEVENLABS_MODEL_ID; new pipeline uses ELEVENLABS_TTS_MODEL.

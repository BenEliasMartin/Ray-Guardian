# Copy to .env and fill in. .env is gitignored; never commit it.

# Nemotron (Verda) API key
VERDA_INFERENCE_KEY=

# ElevenLabs API key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4
# Jack John - Conversational and Upbeat
ELEVENLABS_VOICE_ID=7EzWGsX10sAS4c9m9cPf

# Random development token (32+ chars), e.g. `openssl rand -hex 32`. Not the Verda key.
RAY_GUARDIAN_CLIENT_TOKEN=

# Nemotron endpoint and backend address (defaults usually fine)
VERDA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
VERDA_MODEL=nemotron-3.5-super-vl
HOST=127.0.0.1
PORT=8787
# Address the Android emulator uses to reach the backend
AI_BASE_URL=http://10.0.2.2:8787
